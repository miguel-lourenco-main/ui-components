{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ui-components.dev/contracts/component-meta.schema.json",
  "title": "ComponentMetaContract",
  "type": "object",
  "additionalProperties": true,
  "required": ["id", "name", "category", "description", "props", "tags", "version", "author"],
  "properties": {
    "id": { "type": "string", "minLength": 1, "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "name": { "type": "string", "minLength": 1, "pattern": "^[A-Za-z][A-Za-z0-9]*$" },
    "category": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "author": { "type": "string", "minLength": 1 },
    "code": { "type": "string" },
    "tags": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "dependencies": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "props": {
      "type": "array",
      "items": { "$ref": "#/$defs/prop" }
    }
  },
  "$defs": {
    "prop": {
      "type": "object",
      "additionalProperties": true,
      "required": ["name", "type", "required"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "type": {
          "oneOf": [
            { "type": "string", "minLength": 1 },
            { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 }
          ]
        },
        "required": { "type": "boolean" },
        "defaultValue": {},
        "description": { "type": "string" },
        "options": {
          "type": "array",
          "items": { "type": ["string", "number"] }
        },
        "functionSignature": {
          "type": "object",
          "required": ["params", "returnType"],
          "properties": {
            "params": { "type": "string" },
            "returnType": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
